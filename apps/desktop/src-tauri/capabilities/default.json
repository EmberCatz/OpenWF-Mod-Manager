{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main OpenWF Mod Manager window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.workers.dev/*" },
        { "url": "https://*.r2.dev/*" },
        { "url": "https://*.r2.cloudflarestorage.com/*" }
      ]
    },
    "fs:default",
    "fs:allow-app-write-recursive"
  ]
}
