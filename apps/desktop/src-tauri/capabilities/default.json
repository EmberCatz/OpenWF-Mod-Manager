{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main OpenWF Mod Manager window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.workers.dev/*" },
        { "url": "https://github.com/*" },
        { "url": "https://objects.githubusercontent.com/*" },
        { "url": "https://release-assets.githubusercontent.com/*" },
        { "url": "http://localhost:*/*" }
      ]
    },
    "dialog:default"
  ]
}
