# Copy to .dev.vars (gitignored) for local `wrangler dev`.
# In production, set the real values with:
#   wrangler secret put UPLOAD_API_KEY_SALT
#   wrangler secret put GITHUB_TOKEN

UPLOAD_API_KEY_SALT=change-me-to-a-long-random-string

# Fine-grained GitHub PAT scoped to just the storage repo, with
# "Contents: Read and write" permission (needed to create releases and
# upload assets). Generate at https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=github_pat_change-me

# Optional. Free-tier key from https://www.virustotal.com/gui/my-apikey
# (needs a free account). Backs the scheduled malware scan of uploaded mod
# files (src/scan.ts) — leave unset locally if you're not testing that.
VIRUSTOTAL_API_KEY=

# Optional. Shared secret for POST /api/internal/run-scan-cycle — the
# external GitHub Actions workaround for Cloudflare's native Cron Trigger
# not firing (see index.ts's comment on that route). Any long random
# string; must match the GitHub repo's SCAN_TRIGGER_SECRET Actions secret.
SCAN_TRIGGER_SECRET=
