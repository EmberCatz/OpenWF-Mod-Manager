{
  "name": "@openwf-mod-manager/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute openwf-mod-manager --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute openwf-mod-manager --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "modder:create": "node scripts/create-modder.mjs",
    "modder:grant-admin": "node scripts/grant-admin.mjs",
    "reports:list": "wrangler d1 execute openwf-mod-manager --remote --command \"SELECT id, target_type, target_id, reason, created_at FROM reports WHERE status = 'open' ORDER BY created_at DESC\""
  },
  "dependencies": {
    "@openwf-mod-manager/shared": "*",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.130.0"
  }
}
