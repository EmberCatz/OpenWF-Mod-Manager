    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@openwf-mod-manager/shared": "*"
  },
  "devDependencies": {
    "wrangler": "^3.99.0",
    "typescript": "^5.6.0",
    "@cloudflare/workers-types": "^4.20250101.0"
  }
}
